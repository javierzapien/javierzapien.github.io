---
import Base from '../../layouts/Base.astro';
import MoreProjects from '../../components/MoreProjects.astro';
import { projects, getProject } from '../../data/projects.js';
import { img, srcset } from '../../lib/images.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug);
if (!project) return Astro.redirect('/portfolio');

// Group the gallery: consecutive `half` items pair into one 2-up row.
const rows = [];
for (const item of project.gallery ?? []) {
  const last = rows[rows.length - 1];
  if (item.span === 'half' && last?.kind === 'half' && last.items.length === 1) {
    last.items.push(item);
  } else {
    rows.push({ kind: item.span === 'half' ? 'half' : 'full', items: [item] });
  }
}
---

<Base
  title={`${project.breadcrumb} — Javier Zapien`}
  description={project.excerpt}
  ogImage={img(project.hero, 'og')}
  bleed
>
  <article class="project">
    <p class="project__crumb container section-label">
      {project.breadcrumb} <span class="arrow" aria-hidden="true">&larr;</span>
    </p>

    <div class="project__hero">
      <img
        src={img(project.hero, 'hero')}
        srcset={srcset(project.hero, [768, 1280, 1920])}
        sizes="100vw"
        alt={project.title}
        width="1440"
        height="900"
        decoding="async"
      />
    </div>

    <div class="project__intro container">
      <hr class="project__rule" />
      <p class="project__tags t-meta">{project.tags.join(', ')}</p>
      <p class="project__text">{project.intro}</p>
    </div>

    {rows.length > 0 && (
      <div class="gallery">
        {rows.map((row) => (
          <div class:list={['gallery__row', `gallery__row--${row.kind}`]}>
            {row.items.map((it) => (
              <img
                src={img(it.id, row.kind === 'half' ? 'gallery' : 'gallery')}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        ))}
      </div>
    )}

    <div class="container">
      <MoreProjects currentSlug={project.slug} />
    </div>
  </article>
</Base>

<style>
  .project {
    padding-top: var(--space-content-top);
  }

  /* Breadcrumb */
  .project__crumb {
    margin-bottom: 16px;
  }

  /* Hero — full-bleed on every breakpoint */
  .project__hero {
    width: 100%;
  }
  .project__hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-surface);
  }

  /* Intro block */
  .project__intro {
    margin-top: var(--space-24);
  }
  .project__rule {
    border: 0;
    border-top: 1px solid var(--color-rule);
    margin: 0 0 var(--space-24);
  }
  .project__tags {
    color: var(--color-ink);
    margin-bottom: var(--space-16);
  }
  .project__text {
    font-family: var(--font-sans);
    font-size: var(--type-body-large);
    line-height: normal;
  }

  /* Gallery — full-bleed on mobile/tablet, inset to the content column on desktop */
  .gallery {
    margin-top: var(--space-section-top);
    display: grid;
    gap: var(--gallery-gap);
  }
  .gallery__row {
    display: grid;
    gap: var(--gallery-gap);
  }
  .gallery__row img {
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--color-surface);
  }
  .gallery__row--full img {
    aspect-ratio: 1390 / 805;
  }
  .gallery__row--half img {
    aspect-ratio: 683 / 890;
  }

  @media (min-width: 768px) {
    .gallery__row--half {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    /* the paragraph is a centred column, per the Figma frame */
    .project__text {
      max-width: 62ch;
      margin-inline: auto;
    }
    .gallery {
      max-width: var(--site-max);
      margin-inline: auto;
      padding-inline: var(--layout-margin);
    }
  }
</style>
