---
import Base from '../../layouts/Base.astro';
import MoreProjects from '../../components/MoreProjects.astro';
import Img from '../../components/Img.astro';
import { projects, getProject } from '../../data/projects.js';
import { asset, galleryIds } from '../../lib/assets.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug);
if (!project) return Astro.redirect('/portfolio');

// Gallery rows. If projects.js defines an explicit `gallery` (with optional
// 'half' spans that pair 2-up, forced Figma aspect ratios), use it. Otherwise
// auto-discover every NN.jpg for the project and stack them full-width at their
// natural aspect ratio.
const rows = [];
const push = (kind, id) => {
  const last = rows[rows.length - 1];
  if (kind === 'half' && last?.kind === 'half' && last.items.length === 1) {
    last.items.push(id);
  } else {
    rows.push({ kind, items: [id] });
  }
};

if (project.gallery?.length) {
  // Explicit arrangement from projects.js.
  for (const item of project.gallery) push(item.span === 'half' ? 'half' : 'full', item.id);
} else {
  // Auto: portrait images pair 2-up, landscape images go full-width — matches
  // how the Figma project frames are laid out.
  for (const id of galleryIds(slug)) {
    const meta = asset(`projects/${id}`);
    const portrait = meta && meta.height > meta.width * 1.1;
    push(portrait ? 'half' : 'full', id);
  }
}
// A lone unpaired portrait renders centred, not stretched across a 2-up row.
for (const row of rows) if (row.kind === 'half' && row.items.length === 1) row.kind = 'half-solo';
---

<Base
  title={`${project.breadcrumb} — Javier Zapien`}
  description={project.excerpt}
  bleed
>
  <article class="project">
    <p class="project__crumb container section-label">
      {project.breadcrumb} <span class="arrow" aria-hidden="true">&larr;</span>
    </p>

    <div class="project__hero">
      <Img
        id={`projects/${project.slug}/hero`}
        alt={project.title}
        ratio="16 / 10"
        class="project__hero-img"
        sizes="100vw"
        widths={[768, 1280, 1920, 2560]}
        loading="eager"
      />
    </div>

    <div class="project__intro container">
      <hr class="project__rule" />
      <p class="project__tags t-meta">{project.tags.join(', ')}</p>
      <p class="project__text">{project.intro}</p>
    </div>

    {rows.length > 0 && (
      <div class="gallery">
        {rows.map((row) => (
          <div class:list={['gallery__row', `gallery__row--${row.kind}`]}>
            {row.items.map((id) => (
              <Img
                id={`projects/${id}`}
                alt=""
                ratio={row.kind.startsWith('half') ? '683 / 890' : '1390 / 805'}
                class="gallery__img"
                sizes={row.kind === 'half' ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 60vw, 100vw'}
                widths={row.kind.startsWith('half') ? [480, 768, 1200] : [768, 1280, 1920, 2560]}
              />
            ))}
          </div>
        ))}
      </div>
    )}

    <div class="container">
      <MoreProjects currentSlug={project.slug} />
    </div>
  </article>
</Base>

<style>
  .project {
    padding-top: var(--space-content-top);
  }

  /* Breadcrumb */
  .project__crumb {
    margin-bottom: 16px;
  }

  /* Hero — full-bleed on every breakpoint */
  .project__hero {
    width: 100%;
  }
  .project__hero :global(.project__hero-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-surface);
  }

  /* Intro block */
  .project__intro {
    margin-top: var(--space-24);
  }
  .project__rule {
    border: 0;
    border-top: 1px solid var(--color-rule);
    margin: 0 0 var(--space-24);
  }
  .project__tags {
    color: var(--color-ink);
    margin-bottom: var(--space-16);
  }
  .project__text {
    font-family: var(--font-sans);
    font-size: var(--type-body-large);
    line-height: normal;
  }

  /* Gallery — full-bleed on mobile/tablet, inset to the content column on desktop */
  .gallery {
    margin-top: var(--space-section-top);
    display: grid;
    gap: var(--gallery-gap);
  }
  .gallery__row {
    display: grid;
    gap: var(--gallery-gap);
  }
  .gallery__row :global(.gallery__img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--color-surface);
  }
  .gallery__row--full :global(.gallery__img) {
    aspect-ratio: 1390 / 805;
  }
  .gallery__row--half :global(.gallery__img),
  .gallery__row--half-solo :global(.gallery__img) {
    aspect-ratio: 683 / 890;
  }
  .gallery__row--half-solo {
    justify-items: center;
  }

  @media (min-width: 768px) {
    .gallery__row--half {
      grid-template-columns: 1fr 1fr;
    }
    .gallery__row--half-solo :global(.gallery__img) {
      width: calc(50% - var(--gallery-gap) / 2);
    }
  }

  @media (min-width: 1024px) {
    /* the paragraph is a centred column, per the Figma frame */
    .project__text {
      max-width: 62ch;
      margin-inline: auto;
    }
    .gallery {
      max-width: var(--site-max);
      margin-inline: auto;
      padding-inline: var(--layout-margin);
    }
  }
</style>
