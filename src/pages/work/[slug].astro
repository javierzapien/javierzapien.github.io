---
import Base from '../../layouts/Base.astro';
import MoreProjects from '../../components/MoreProjects.astro';
import { projects, getProject } from '../../data/projects.js';
import { img, srcset } from '../../lib/images.js';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug);
if (!project) return Astro.redirect('/portfolio');
---

<Base
  title={`${project.breadcrumb} — Javier Zapien`}
  description={project.excerpt}
  ogImage={img(project.hero, 'og')}
>
  <article class="project">
    <p class="project__breadcrumb section-label">
      <a class="u-link" href="/portfolio">Portfolio</a>
      <span aria-hidden="true"> / </span>{project.breadcrumb}
    </p>

    <h1 class="project__title t-body-large">{project.title}</h1>

    <div class="project__hero">
      <img
        src={img(project.hero, 'hero')}
        srcset={srcset(project.hero, [768, 1200, 1800])}
        sizes="100vw"
        alt={project.title}
        width="1800"
        height="1125"
        decoding="async"
      />
    </div>

    <p class="project__intro t-body">{project.intro}</p>
    <p class="project__tags t-meta">{project.tags.join(', ')}</p>

    {project.gallery.length > 0 && (
      <div class="project__gallery">
        {project.gallery.map((g) => (
          <img src={img(g, 'gallery')} alt="" loading="lazy" decoding="async" />
        ))}
      </div>
    )}

    <MoreProjects currentSlug={project.slug} />
  </article>
</Base>

<style>
  .project {
    padding-block: var(--space-section-top);
  }
  .project__title {
    margin-top: var(--space-16);
  }
  .project__hero {
    margin-top: var(--space-24);
    margin-inline: calc(var(--layout-margin) * -1);
  }
  .project__hero img {
    width: 100%;
    height: auto;
  }
  .project__intro {
    margin-top: var(--space-24);
    max-width: 42rem;
  }
  .project__tags {
    margin-top: var(--space-16);
    color: var(--color-ink);
  }
  .project__gallery {
    margin-top: var(--space-40);
    display: grid;
    gap: var(--space-16);
  }
  @media (min-width: 1024px) {
    .project__hero {
      margin-inline: 0;
    }
  }
</style>
