---
import Base from '../layouts/Base.astro';
import { logos } from '../data/projects.js';
---

<Base title="Logofolio — Javier Zapien">
  <section class="logofolio">
    <h1 class="section-label">Logofolio <span class="arrow" aria-hidden="true">&larr;</span></h1>
    <div class="logo-grid">
      {logos.map((logo, i) => (
        <div class="logo-tile">
          {logo.mark ? (
            <img src={logo.mark} alt={logo.name} loading="lazy" decoding="async" />
          ) : (
            <span class="logo-tile__ph">{String(i + 1).padStart(2, '0')}</span>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .logofolio {
    padding-top: var(--space-content-top);
  }
  .logofolio .section-label {
    margin-bottom: var(--space-24);
  }

  .logo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 19px;
  }
  .logo-tile {
    aspect-ratio: 327 / 172;
    display: grid;
    place-items: center;
    background: var(--color-logo-tile);
  }
  .logo-tile img {
    max-width: 30%;
    max-height: 42%;
    width: auto;
    height: auto;
  }
  .logo-tile__ph {
    font-family: var(--font-mono);
    font-size: var(--type-meta);
    letter-spacing: var(--tracking-mono);
    color: rgba(255, 255, 255, 0.25);
  }

  @media (min-width: 768px) {
    .logo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .logo-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
