---
import { SITE } from '../data/projects.js';
---

<span class="clock" aria-live="off">
  <span class="clock__loc">{SITE.location} <span aria-hidden="true">&rarr;</span></span>
  <span class="clock__ts" data-dubai-clock>&nbsp;</span>
</span>

<style>
  .clock {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    font-family: var(--font-sans);
    color: var(--color-ink);
  }
  .clock__loc {
    white-space: nowrap;
  }
  .clock__ts {
    /* wraps to "…, 2026" / "HH:MM:SS" like the Figma frames */
    max-width: 15ch;
  }
</style>

<script>
  const TZ = 'Asia/Dubai';
  const dateFmt = new Intl.DateTimeFormat('en-US', {
    timeZone: TZ,
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
  const timeFmt = new Intl.DateTimeFormat('en-US', {
    timeZone: TZ,
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  });
  const nodes = document.querySelectorAll('[data-dubai-clock]');
  function tick() {
    const now = new Date();
    const s = `${dateFmt.format(now)} ${timeFmt.format(now)}`;
    nodes.forEach((n) => (n.textContent = s));
  }
  tick();
  setInterval(tick, 1000);
</script>
