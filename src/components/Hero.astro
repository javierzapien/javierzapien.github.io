---
import { getImage } from 'astro:assets';
import { heroSlides, HERO_INTERVAL_MS } from '../data/projects.js';
import { asset } from '../lib/assets.js';
import Img from './Img.astro';

// Desktop (>=1024px) uses the Figma 1440x620 exports in hero-desktop/;
// mobile + tablet keep the crops in hero/. One <picture> per slide.
const DESKTOP_WIDTHS = [1280, 1920, 2560, 2880];
const SMALL_WIDTHS = [600, 900, 1400, 1920, 2560];
const variants = async (meta, widths) => {
  const imgs = await Promise.all(widths.map((w) => getImage({ src: meta, width: w, format: 'webp' })));
  return { srcset: imgs.map((img, i) => `${img.src} ${widths[i]}w`).join(', '), src: imgs[Math.min(2, imgs.length - 1)].src };
};

const slides = await Promise.all(
  heroSlides.map(async (slide) => {
    const desktop = asset(`hero-desktop/${slide.src}`);
    const small = asset(`hero/${slide.src}`);
    return {
      ...slide,
      desktop: desktop && typeof desktop === 'object' ? (await variants(desktop, DESKTOP_WIDTHS)).srcset : null,
      small: small && typeof small === 'object' ? await variants(small, SMALL_WIDTHS) : null,
    };
  })
);
---

<section class="hero" aria-label="Selected work" data-interval={HERO_INTERVAL_MS}>
  {
    slides.map((slide, i) => (
      <a class:list={['hero__slide', i === 0 && 'is-active']} href={slide.slug ? `/work/${slide.slug}` : '/portfolio'}>
        {slide.small ? (
          <picture>
            {slide.desktop && <source media="(min-width: 1024px)" srcset={slide.desktop} sizes="100vw" type="image/webp" />}
            <img
              class="hero__img"
              src={slide.small.src}
              srcset={slide.small.srcset}
              sizes="100vw"
              alt={slide.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        ) : (
          <Img id={`hero/${slide.src}`} alt={slide.alt} class="hero__img" sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
        )}
      </a>
    ))
  }
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: var(--hero-height);
    margin-top: var(--hero-gap-top, 0);
    overflow: hidden;
    background: var(--color-surface);
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms ease-in-out;
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__slide picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__slide :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('.hero__slide'));
    const interval = Number(hero.dataset.interval) || 5000;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function show(n: number) {
      slides[i]?.classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i]?.classList.add('is-active');
    }
    function start() {
      if (!reduce && slides.length > 1 && !timer) timer = setInterval(() => show(i + 1), interval);
    }
    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    }
    document.addEventListener('visibilitychange', () =>
      document.visibilityState === 'hidden' ? stop() : start()
    );
    start();
  }
</script>
