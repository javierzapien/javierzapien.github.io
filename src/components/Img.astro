---
import { Image } from 'astro:assets';
import { asset } from '../lib/assets.js';

interface Props {
  id: string;
  alt?: string;
  ratio?: string; // "3 / 2" — box shape for the placeholder / <img>
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fallbackId?: string;
}

const {
  id,
  alt = '',
  ratio,
  widths = [480, 768, 1200, 1800, 2400],
  sizes = '100vw',
  class: className,
  loading = 'lazy',
  fallbackId,
} = Astro.props;

const meta = asset(id) ?? (fallbackId ? asset(fallbackId) : null);

const [rw, rh] = ratio
  ? ratio.split('/').map((n) => Number(n.trim()))
  : [3, 2];
const w = 1200;
const h = Math.round((w * rh) / rw);

function placeholder(seed, width, height) {
  const label = (seed || 'image').split('/').slice(-2).join('/');
  let hash = 0;
  for (let i = 0; i < (seed || '').length; i++) hash = (hash * 31 + seed.charCodeAt(i)) | 0;
  const hue = Math.abs(hash) % 360;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}"><rect width="100%" height="100%" fill="hsl(${hue} 12% 86%)"/><text x="50%" y="50%" fill="hsl(${hue} 15% 40%)" font-family="monospace" font-size="${Math.round(width / 24)}" text-anchor="middle" dominant-baseline="middle">${label}</text></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}
---

{
  meta ? (
    <Image
      src={meta}
      alt={alt}
      widths={widths}
      sizes={sizes}
      class={className}
      loading={loading}
    />
  ) : (
    <img
      src={placeholder(id, w, h)}
      alt={alt}
      class={className}
      width={w}
      height={h}
      loading={loading}
      decoding="async"
    />
  )
}
