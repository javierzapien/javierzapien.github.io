---
/**
 * Shared "scoop corner" clip-path: top corners lightly rounded, bottom
 * corners cut with a deep concave arc (fabric-pinched look). Applied via
 * `class="scoop"` to an image/video wrapper (see global.css). One shared
 * <clipPath> drives every `.scoop` element on the page, and its path is
 * redrawn on scroll so the scoop deepens with scroll speed and eases back
 * to rest — the "distortion" effect.
 */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="scoop-clip" clipPathUnits="objectBoundingBox">
      <path id="scoop-clip-path" d="" />
    </clipPath>
  </defs>
</svg>

<script>
  const path = document.getElementById('scoop-clip-path');
  if (path) {
    const R = 0.035; // top corner radius (fraction of box)
    const K_BASE = 0.15; // resting bottom-corner scoop depth
    const K_MAX = 0.11; // extra scoop added at full scroll speed

    function shape(k: number, r: number) {
      return (
        `M ${r} 0 L ${1 - r} 0 A ${r} ${r} 0 0 1 1 ${r} ` +
        `L 1 ${1 - k} A ${k} ${k} 0 0 0 ${1 - k} 1 ` +
        `L ${k} 1 A ${k} ${k} 0 0 0 0 ${1 - k} ` +
        `L 0 ${r} A ${r} ${r} 0 0 1 ${r} 0 Z`
      );
    }

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      path.setAttribute('d', shape(K_BASE, R));
    } else {
      let lastY = window.scrollY;
      let velocity = 0;
      let distort = 0;

      function tick() {
        const y = window.scrollY;
        velocity = velocity * 0.8 + (y - lastY) * 0.2;
        lastY = y;
        const target = Math.min(Math.abs(velocity) / 45, 1);
        distort += (target - distort) * 0.12;
        path!.setAttribute('d', shape(K_BASE + distort * K_MAX, R));
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
  }
</script>
