---
/**
 * Pixel-block scroll reveal for images marked `reveal` on <Img>.
 * See src/lib/pixel-reveal/ — adapted from J0SUKE's Codrops demo (MIT):
 * https://github.com/J0SUKE/gsap-threejs-codrops
 */
---

<canvas id="pixel-reveal-canvas" aria-hidden="true"></canvas>

<style>
  #pixel-reveal-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 2;
  }
</style>

<script>
  import { initPixelReveal } from '../lib/pixel-reveal/index.js';
  initPixelReveal();
</script>
